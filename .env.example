# Secrets only. All defaults, models, URLs and paths live in backend/config.jsonc.
# Copy to .env and fill. Local values can be generated with `make init`.

# Database
DB_NAME=stockline
DB_USER=stockline
POSTGRES_PASSWORD=

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=
STOCKLINE_ADMIN_USER=manager
STOCKLINE_ADMIN_PASSWORD=

# AI provider
NVIDIA_API_KEY=
